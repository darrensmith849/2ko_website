# The /api/contact handler sends through Cloudflare Email Sending using the
# `send_email` binding EMAIL declared in wrangler.jsonc. No API key needed.

# Optional overrides (sane defaults already in the route handler):
# CONTACT_TO_EMAIL=info@2ko.co.za
# CONTACT_FROM_EMAIL=noreply@2ko.co.za   # must be on a domain onboarded for Email Sending
# CONTACT_FROM_NAME=2KO Website
