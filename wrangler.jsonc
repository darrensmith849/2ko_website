/**
 * Cloudflare Worker config — built by `@opennextjs/cloudflare`.
 *
 * Deploys via:   npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy
 * Local preview: npx opennextjs-cloudflare build && npx wrangler dev
 *
 * Contact form email goes out through Cloudflare Email Sending via the
 * `send_email` binding EMAIL (used by app/api/contact). 2ko.co.za is
 * onboarded for Email Sending, so no API key or secret is needed.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2ko-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    { "name": "EMAIL" }
  ]
}
